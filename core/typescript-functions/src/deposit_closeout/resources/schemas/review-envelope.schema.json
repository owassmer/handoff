{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:handoff:deposit-closeout:ReviewEnvelope:1.1.0",
  "$ref": "#/$defs/ReviewEnvelope",
  "$defs": {
    "ReviewEnvelope": {
      "type": "object",
      "properties": {
        "metadata": {
          "$ref": "#/$defs/ReviewMetadata"
        },
        "result": {
          "$ref": "#/$defs/ReviewResult"
        }
      },
      "required": [
        "metadata",
        "result"
      ],
      "additionalProperties": false
    },
    "ReviewMetadata": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "minLength": 1,
          "const": "1.1.0"
        },
        "baseCaseRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-foundry-type": "Long"
        },
        "inputHash": {
          "type": "string",
          "minLength": 1
        },
        "ruleReleaseId": {
          "type": "string",
          "minLength": 1
        },
        "codeVersion": {
          "type": "string",
          "minLength": 1
        },
        "reviewClock": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "schemaVersion",
        "baseCaseRevision",
        "inputHash",
        "ruleReleaseId",
        "codeVersion",
        "reviewClock"
      ],
      "additionalProperties": false
    },
    "ReviewResult": {
      "type": "object",
      "properties": {
        "scopeRequirements": {
          "$ref": "#/$defs/ScopeRequirements"
        },
        "itemDecisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemDecision"
          }
        },
        "account": {
          "$ref": "#/$defs/AccountResult"
        },
        "missingInputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OpenQuestion"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AvailableAction"
          }
        },
        "outcomes": {
          "$ref": "#/$defs/Outcomes"
        }
      },
      "required": [
        "scopeRequirements",
        "itemDecisions",
        "account",
        "missingInputs",
        "actions",
        "outcomes"
      ],
      "additionalProperties": false
    },
    "ScopeRequirements": {
      "type": "object",
      "properties": {
        "scopeState": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "SUPPORTED",
            "UNSUPPORTED",
            "MISSING_FACTS",
            "INTERPRETATION_REQUIRED"
          ]
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 1
        },
        "regime": {
          "type": "string",
          "minLength": 1
        },
        "ruleReleaseId": {
          "type": "string",
          "minLength": 1
        },
        "ruleStatus": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "SYNTHETIC_ONLY",
            "REVIEWED_FOR_SCOPE"
          ]
        },
        "appliedQuestionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RequirementResult"
          }
        }
      },
      "required": [
        "scopeState",
        "jurisdiction",
        "regime",
        "ruleReleaseId",
        "ruleStatus",
        "appliedQuestionIds",
        "limitations",
        "requirements"
      ],
      "additionalProperties": false
    },
    "RequirementResult": {
      "type": "object",
      "properties": {
        "requirementKey": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "ruleQuestionId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "track": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "DECISIONS",
            "COMMUNICATIONS",
            "APPROVALS",
            "MONEY",
            "RELATED_ACCOUNT"
          ]
        },
        "dueKind": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "LEGAL",
            "INTERNAL",
            "UNCONFIRMED"
          ]
        },
        "legalDueDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "internalTargetAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "triggerFactKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "OPEN",
            "BLOCKED",
            "READY",
            "PENDING",
            "FULFILLED",
            "FAILED",
            "REOPENED",
            "NOT_APPLICABLE"
          ]
        },
        "responsibleRole": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "MANAGER",
            "ACCOUNTANT",
            "AUTHORITY_ADMIN",
            "OWNER",
            "RESIDENT",
            "SIGNATORY",
            "CUSTODIAN",
            "REVIEWER",
            "DEMO_TESTER",
            "AUTOMATION"
          ]
        },
        "prerequisiteIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "completionCondition": {
          "type": "string",
          "minLength": 1
        },
        "completionEvidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "requirementKey",
        "question",
        "ruleQuestionId",
        "track",
        "dueKind",
        "legalDueDate",
        "internalTargetAt",
        "triggerFactKeys",
        "state",
        "responsibleRole",
        "prerequisiteIds",
        "completionCondition",
        "completionEvidenceIds",
        "reason"
      ],
      "additionalProperties": false
    },
    "ItemDecision": {
      "type": "object",
      "properties": {
        "itemId": {
          "type": "string",
          "minLength": 1
        },
        "costVersionId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "vendorCostCents": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "x-foundry-type": "Long"
            },
            {
              "type": "null"
            }
          ],
          "minimum": 0
        },
        "allocation": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "TENANT",
            "OWNER",
            "SPLIT",
            "OTHER",
            "UNRESOLVED"
          ]
        },
        "allowability": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "SUPPORTED",
            "DISALLOWED",
            "UNRESOLVED",
            "NOT_EVALUATED"
          ]
        },
        "supportedAmountCents": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "x-foundry-type": "Long"
            },
            {
              "type": "null"
            }
          ],
          "minimum": 0
        },
        "chosenAmountCents": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "x-foundry-type": "Long"
            },
            {
              "type": "null"
            }
          ],
          "minimum": 0
        },
        "choiceState": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "NOT_DECIDED",
            "CHOSEN",
            "WAIVED",
            "NOT_APPLICABLE"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "sourceReferences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceReference"
          }
        },
        "ruleQuestionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "missingInputIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiresReviewer": {
          "type": "boolean"
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "itemId",
        "costVersionId",
        "vendorCostCents",
        "allocation",
        "allowability",
        "supportedAmountCents",
        "chosenAmountCents",
        "choiceState",
        "reason",
        "sourceReferences",
        "ruleQuestionIds",
        "missingInputIds",
        "requiresReviewer",
        "fingerprint"
      ],
      "additionalProperties": false
    },
    "SourceReference": {
      "type": "object",
      "properties": {
        "evidenceId": {
          "type": "string",
          "minLength": 1
        },
        "sourceClass": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "CASE_RECORD",
            "AGREEMENT",
            "LAW",
            "PROCEDURE",
            "TEST_ASSUMPTION",
            "MODEL_PROPOSAL"
          ]
        },
        "sourceVersion": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ],
          "minimum": 1
        },
        "quote": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "evidenceId",
        "sourceClass",
        "sourceVersion",
        "locator",
        "page",
        "quote"
      ],
      "additionalProperties": false
    },
    "AccountResult": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "minLength": 1,
          "const": "USD"
        },
        "recordedDepositCents": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "x-foundry-type": "Long"
            },
            {
              "type": "null"
            }
          ],
          "minimum": 0
        },
        "balanceSourceEvidenceId": {
          "type": "string",
          "minLength": 1
        },
        "balanceAsOf": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "reconciliationState": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "RECONCILED",
            "UNRECONCILED",
            "CONFLICT"
          ]
        },
        "knownChosenDeductionsCents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-foundry-type": "Long"
        },
        "totalDeductionsCents": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "x-foundry-type": "Long"
            },
            {
              "type": "null"
            }
          ],
          "minimum": 0
        },
        "existingNetPostingCents": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "x-foundry-type": "Long"
            },
            {
              "type": "null"
            }
          ]
        },
        "postingDeltaCents": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "x-foundry-type": "Long"
            },
            {
              "type": "null"
            }
          ]
        },
        "existingDepositApplicationsCents": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "x-foundry-type": "Long"
            },
            {
              "type": "null"
            }
          ]
        },
        "depositApplicationDeltaCents": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "x-foundry-type": "Long"
            },
            {
              "type": "null"
            }
          ]
        },
        "priorNetRefundsCents": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "x-foundry-type": "Long"
            },
            {
              "type": "null"
            }
          ]
        },
        "pendingReservedRefundCents": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "x-foundry-type": "Long"
            },
            {
              "type": "null"
            }
          ],
          "minimum": 0
        },
        "finalRefundCents": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "x-foundry-type": "Long"
            },
            {
              "type": "null"
            }
          ],
          "minimum": 0
        },
        "proposedExcessReceivableCents": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "x-foundry-type": "Long"
            },
            {
              "type": "null"
            }
          ],
          "minimum": 0
        },
        "unresolvedItemIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "otherBalanceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "finalAccountReady": {
          "type": "boolean"
        },
        "notFinalReasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recipientInstructionsVersion": {
          "type": "string",
          "minLength": 1
        },
        "recipientState": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "VERIFIED",
            "MISSING",
            "DISPUTED",
            "REVIEW_REQUIRED"
          ]
        }
      },
      "required": [
        "currency",
        "recordedDepositCents",
        "balanceSourceEvidenceId",
        "balanceAsOf",
        "reconciliationState",
        "knownChosenDeductionsCents",
        "totalDeductionsCents",
        "existingNetPostingCents",
        "postingDeltaCents",
        "existingDepositApplicationsCents",
        "depositApplicationDeltaCents",
        "priorNetRefundsCents",
        "pendingReservedRefundCents",
        "finalRefundCents",
        "proposedExcessReceivableCents",
        "unresolvedItemIds",
        "otherBalanceIds",
        "finalAccountReady",
        "notFinalReasons",
        "recipientInstructionsVersion",
        "recipientState"
      ],
      "additionalProperties": false
    },
    "OpenQuestion": {
      "type": "object",
      "properties": {
        "questionId": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "resolverRole": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "MANAGER",
            "ACCOUNTANT",
            "AUTHORITY_ADMIN",
            "OWNER",
            "RESIDENT",
            "SIGNATORY",
            "CUSTODIAN",
            "REVIEWER",
            "DEMO_TESTER",
            "AUTOMATION"
          ]
        },
        "resolverPartyId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "neededRecord": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "affectedItemIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "affectedActionKinds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "OPEN_CASE",
              "ADD_EVIDENCE",
              "ACCEPT_OR_CORRECT_FACT",
              "SET_OR_REVOKE_AUTHORITY",
              "RECORD_CHARGE_DECISION",
              "CHOOSE_OR_WAIVE_CHARGE",
              "SET_RECIPIENT_INSTRUCTIONS",
              "RECONCILE_MONEY_RECORD",
              "PREPARE_STATEMENT",
              "APPROVE_EXACT_VERSION",
              "REJECT_OR_REVOKE_APPROVAL",
              "REQUEST_STATEMENT_DISPATCH",
              "REQUEST_REFUND",
              "REQUEST_LEDGER_POSTING",
              "RECORD_DEMO_OUTCOME",
              "RECORD_MANUAL_CONFIRMATION",
              "RESOLVE_UNKNOWN_RESULT",
              "AUTHORIZE_REPLACEMENT_ATTEMPT",
              "ASSIGN_WORK",
              "RECORD_RELATED_TASK_RESULT",
              "RECHECK_CASE",
              "ADVANCE_DEMO_CLOCK"
            ]
          }
        }
      },
      "required": [
        "questionId",
        "question",
        "reason",
        "resolverRole",
        "resolverPartyId",
        "neededRecord",
        "affectedItemIds",
        "affectedActionKinds"
      ],
      "additionalProperties": false
    },
    "AvailableAction": {
      "type": "object",
      "properties": {
        "actionKey": {
          "type": "string",
          "minLength": 1
        },
        "actionKind": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "OPEN_CASE",
            "ADD_EVIDENCE",
            "ACCEPT_OR_CORRECT_FACT",
            "SET_OR_REVOKE_AUTHORITY",
            "RECORD_CHARGE_DECISION",
            "CHOOSE_OR_WAIVE_CHARGE",
            "SET_RECIPIENT_INSTRUCTIONS",
            "RECONCILE_MONEY_RECORD",
            "PREPARE_STATEMENT",
            "APPROVE_EXACT_VERSION",
            "REJECT_OR_REVOKE_APPROVAL",
            "REQUEST_STATEMENT_DISPATCH",
            "REQUEST_REFUND",
            "REQUEST_LEDGER_POSTING",
            "RECORD_DEMO_OUTCOME",
            "RECORD_MANUAL_CONFIRMATION",
            "RESOLVE_UNKNOWN_RESULT",
            "AUTHORIZE_REPLACEMENT_ATTEMPT",
            "ASSIGN_WORK",
            "RECORD_RELATED_TASK_RESULT",
            "RECHECK_CASE",
            "ADVANCE_DEMO_CLOCK"
          ]
        },
        "availability": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "AVAILABLE",
            "BLOCKED",
            "NOT_APPLICABLE"
          ]
        },
        "responsibleRole": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "MANAGER",
            "ACCOUNTANT",
            "AUTHORITY_ADMIN",
            "OWNER",
            "RESIDENT",
            "SIGNATORY",
            "CUSTODIAN",
            "REVIEWER",
            "DEMO_TESTER",
            "AUTOMATION"
          ]
        },
        "targetVersionId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "payloadFingerprint": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "amountCents": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "x-foundry-type": "Long"
            },
            {
              "type": "null"
            }
          ],
          "minimum": 0
        },
        "prerequisiteIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiredApprovalScopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "fallbackDescription": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "actionKey",
        "actionKind",
        "availability",
        "responsibleRole",
        "targetVersionId",
        "payloadFingerprint",
        "amountCents",
        "prerequisiteIds",
        "requiredApprovalScopes",
        "reason",
        "fallbackDescription"
      ],
      "additionalProperties": false
    },
    "Outcomes": {
      "type": "object",
      "properties": {
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TrackOutcome"
          }
        },
        "depositComplete": {
          "type": "boolean"
        },
        "overallCaseComplete": {
          "type": "boolean"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "tracks",
        "depositComplete",
        "overallCaseComplete",
        "summary"
      ],
      "additionalProperties": false
    },
    "TrackOutcome": {
      "type": "object",
      "properties": {
        "track": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "DECISIONS",
            "COMMUNICATIONS",
            "APPROVALS",
            "MONEY",
            "RELATED_ACCOUNT"
          ]
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "OPEN",
            "BLOCKED",
            "READY",
            "PENDING",
            "FULFILLED",
            "FAILED",
            "REOPENED",
            "NOT_APPLICABLE"
          ]
        },
        "openRequirementKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
