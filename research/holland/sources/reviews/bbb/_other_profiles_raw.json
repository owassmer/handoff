  "reviews": {
   "items": [
    {
     "reviewStarRating": 1,
     "customerResponseText": null,
     "businessRebuttalDate": null,
     "businessRebuttalText": null,
     "customerResponseDate": null,
     "id": "1296_22561446_789468",
     "extendedText": [],
     "hasExtendedText": false,
     "orgId": 0,
     "reviewStatusId": 1,
     "customerCommentStatusId": null,
     "customerReviewGuid": "9c4abb00-22fc-422a-8472-a5b77e3df227",
     "hasAddComment": false,
     "hasPendingAddComment": false,
     "hasPendingDeleteReview": false,
     "text": "I was a resident during the period of January 2023 to March 2023 and had been living at Bella Terra Apartments for years, The pipes froze and broke and due to this issue, my apartment was not the same for the period of January 2023 into March 2023. With holes in the walls, no floors, constant noise from machines to dry the walls, I was only able to use the bedroom and part of my bathroom of my one bedroom apartment, but yet I was pushed to still pay rent in full each month. The situation that occurred with the pipes breaking had nothing to do with me and was the responsibility of Bella Terra. I was given the option to move out, but as soon as I found a place, that option was quickly retracted, they offered a smaller apartment down the hall at the same rental cost as my bigger apartment. Due to the vey small window I was given and my request for help, I was not able to move within that week. They offered a deduction of $500 on one month of rent, but its is not enough. I worked at night and had to sleep in my car a few times as I could not afford a hotel. With asthma, I endured the dust and noise, sleeping the most 4 hours each day for months. I did not receive what I signed for in my lease. Lease ended in July and I left in June, I inquired about leaving early and could not get an answer and moved out. They are charging me for leaving early and I do not believe I should pay, not after all I have been through. 3 months of h*** to one month of me leaving early, does not add up and this injustice needs to be corrected.",
     "date": {
      "day": "13",
      "month": "04",
      "year": "2025"
     },
