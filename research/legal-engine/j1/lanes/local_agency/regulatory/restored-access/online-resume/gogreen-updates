    <script>
      window.dataLayer = window.dataLayer || [];

      function gtag() {
        dataLayer.push(arguments);
      }

      gtag('js', new Date());

      gtag('config', 'G-N5Y60EJBHF');


      /*
       * GA4 Chatbot Event Tracker
       */
      function trackChatbotEvent(eventName, params = {}) {

        if (typeof gtag === 'function') {

          gtag('event', eventName, {
            event_category: 'Chatbot',
            chatbot_name: 'Chatbase',
            ...params
          });

          console.log('GA4 Event Fired:', eventName, params);
        }

      }



      /*
       * Load Chatbase Widget
       */
      (function () {


        if (!window.chatbase || window.chatbase("getState") !== "initialized") {


          window.chatbase = (...arguments) => {

            if (!window.chatbase.q) {
              window.chatbase.q = [];
            }

            window.chatbase.q.push(arguments);

          };


          window.chatbase = new Proxy(window.chatbase, {

            get(target, prop) {

              if (prop === "q") {
                return target.q;
              }

              return (...args) => target(prop, ...args);

            }

          });

        }



        const loadChatbase = function () {


          const script = document.createElement("script");

          script.src = "https://www.chatbase.co/embed.min.js";

          script.id = "2LnHEs0hvBPvzTTuTeJw9";

          script.domain = "www.chatbase.co";


          document.body.appendChild(script);



          /*
           * Chatbot loaded event
           */
          trackChatbotEvent('chatbot_loaded');



          /*
           * Detect chatbot button clicks
           */
          document.addEventListener(
            'click',
            function(event) {


              let element = event.target;


              console.log(
                'Clicked:',
                element
              );


              /*
               * Chatbase launcher detection
               */
              if (

                element.closest('iframe') ||

                element.closest('[id*="chat"]') ||

                element.closest('[class*="chat"]')

              ) {


                trackChatbotEvent(
                  'chatbot_open'
                );


              }


            },
            true
          );


        };



        if (document.readyState === "complete") {

          loadChatbase();

        } else {

          window.addEventListener(
            "load",
            loadChatbase
          );

        }



      })();




      /*
       * Capture Chatbase iframe events
       */
      window.addEventListener(
        "message",
        function(event) {


          console.log(
            "Chatbase Message Received:",
            event.data
          );



          if (!event.data) {
            return;
          }



          let message = event.data;



          if (typeof message === "object") {

            message = JSON.stringify(message);

          }



          message = message.toLowerCase();



          /*
           * Chatbase open/start events
           */
          if (

            message.includes('open') ||

            message.includes('started') ||

            message.includes('start')

          ) {


            trackChatbotEvent(
              'chatbot_open'
            );


          }



          /*
           * Chatbase message events
           */
          if (

            message.includes('message') ||

            message.includes('user')

          ) {


            trackChatbotEvent(
              'chatbot_message',
              {
                action: message.substring(0,100)
              }
            );


          }



          /*
           * Generic Chatbase interaction
           */
          if (

            message.includes('chatbase')

          ) {


            trackChatbotEvent(
              'chatbot_interaction',
              {
                action: message.substring(0,100)
              }
            );


          }


        }
      );

      </script>
